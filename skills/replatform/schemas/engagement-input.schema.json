{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itm8.example/aifactory/replatform/engagement-input.schema.json",
  "title": "AI Factory engagement input (contract C1)",
  "description": "Mirror of the Management App's shared engagement-input schema (engagementInputSchema, schemaVersion 1): the result of the MCP tool replatform_get_engagement_input. The Wizard's answers for steps 1 to 3 and the source reference with its SHA. Read it first and ask the owner only for the fields listed in missing. It is kept in step with the pinned contracts/mgmt/engagement-input.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solutionId",
    "customerId",
    "specification",
    "customer",
    "solution",
    "tenantId",
    "zone",
    "region",
    "allowedRegions",
    "archetype",
    "connectivity",
    "audience",
    "environments",
    "source",
    "missing"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "solutionId": { "type": "string", "format": "uuid" },
    "customerId": { "type": "string", "format": "uuid" },
    "specification": {
      "description": "The solution specification the answers come from, newest revision first. Null when the Wizard's answers were never saved. A draft is the Wizard's answers so far, not an approval.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "status", "sha256"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "revision": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["draft", "pending-approval", "approved", "superseded", "archived"] },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "customer": { "$ref": "#/$defs/named" },
    "solution": { "$ref": "#/$defs/named" },
    "tenantId": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
    "zone": { "oneOf": [{ "type": "null" }, { "enum": ["green", "yellow", "red"] }] },
    "region": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
    "allowedRegions": { "type": "array", "items": { "type": "string" } },
    "archetype": { "oneOf": [{ "type": "null" }, { "enum": ["corp", "online", "public"] }] },
    "connectivity": { "oneOf": [{ "type": "null" }, { "enum": ["internal", "isolated"] }] },
    "audience": { "oneOf": [{ "type": "null" }, { "enum": ["internal", "external", "public"] }] },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level", "subscriptionId"],
        "properties": {
          "name": { "enum": ["dev", "test", "prod"] },
          "level": { "enum": ["basic", "standard", "premium"] },
          "subscriptionId": { "type": "string" }
        }
      }
    },
    "source": {
      "description": "The newest upload of the solution: what it is and its hash, never its content.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uploadId", "fileName", "kind", "sha256", "packageSha256", "uploadedAt"],
          "properties": {
            "uploadId": { "type": "string", "format": "uuid" },
            "fileName": { "type": "string" },
            "kind": { "enum": ["zip", "xml", "repomix"] },
            "sha256": { "$ref": "#/$defs/sha256" },
            "packageSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
            "uploadedAt": { "type": "string" }
          }
        }
      ]
    },
    "missing": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["tenantId", "zone", "region", "archetype", "connectivity", "audience", "environments", "source"] },
      "description": "The answers still open, in this fixed order. They are the only questions the agent may still put to the owner."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "named": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code"],
      "properties": { "name": { "type": "string" }, "code": { "type": "string", "description": "The Wizard's code; empty until the answers are saved." } }
    }
  }
}
