{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itm8:aifactory:ai-factory-spec:1",
  "title": "AI Factory Wizard ai-factory.json v1 (replatform projection)",
  "description": "The documented v1 Wizard input surface used by the replatform agent. Additive Wizard fields remain accepted; consult the pinned Management App source contract before extending this projection.",
  "type": "object",
  "required": [
    "schemaVersion",
    "customer",
    "solution",
    "tenantId",
    "zone",
    "region",
    "environments",
    "delivery"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "generator": {
      "type": "string"
    },
    "customer": {
      "type": "object",
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 400
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,3}$",
          "not": {
            "const": "itm8"
          },
          "description": "2-4 lowercase letters/digits, starts with a letter; itm8 is reserved. Never fabricate this value."
        }
      },
      "additionalProperties": true
    },
    "solution": {
      "type": "object",
      "required": [
        "name",
        "code",
        "owner",
        "costCenter"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 400
        },
        "code": {
          "type": "string",
          "maxLength": 400
        },
        "owner": {
          "type": "string",
          "maxLength": 400
        },
        "costCenter": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": true
    },
    "tenantId": {
      "type": "string",
      "maxLength": 400
    },
    "archetype": {
      "enum": [
        "corp",
        "online",
        "public",
        ""
      ]
    },
    "connectivity": {
      "enum": [
        "internal",
        "isolated",
        ""
      ]
    },
    "audience": {
      "enum": [
        "internal",
        "external",
        "public",
        ""
      ]
    },
    "evaluation": {
      "type": "object",
      "required": [
        "data",
        "expiresOn"
      ],
      "properties": {
        "data": {
          "enum": [
            "synthetic",
            "non-sensitive",
            "personal",
            "sensitive",
            ""
          ]
        },
        "expiresOn": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": true
    },
    "zone": {
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "subZone": {
      "enum": [
        "yellow-public",
        "yellow-internal",
        "red-hub",
        "red-isolated"
      ]
    },
    "soc": {
      "type": "boolean"
    },
    "edge": {
      "type": "object",
      "description": "The edge in front of the web apps (2026-11-10). Optional: absent keeps an App Gateway in every environment. Copy it, with existingId and allowedIps, from the engagement input; else only from the Wizard or a person. Refusals (tierRefusals): Green only none; Yellow public with a Standard or Premium environment not none; front-door never in Red or Yellow-Internal; existing front-door needs existingId.",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["none", "app-gateway", "front-door"] },
        "mode": { "enum": ["new", "existing"] },
        "existingId": { "type": "string", "maxLength": 400 },
        "allowedIps": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 60 } }
      },
      "additionalProperties": false
    },
    "database": {
      "description": "The database engine (2026-11-10). Absent is postgres. cosmos-nosql: no db-setup.sql, no PG* settings, AZURE_COSMOS_ENDPOINT and AZURE_COSMOS_DATABASE; refused in Red.",
      "enum": ["postgres", "cosmos-nosql"]
    },
    "region": {
      "type": "string",
      "maxLength": 400,
      "description": "The Wizard has no region default; empty means unanswered."
    },
    "allowedRegions": {
      "type": "array",
      "items": {
        "enum": [
          "swedencentral",
          "swedensouth",
          "northeurope",
          "westeurope",
          "germanywestcentral",
          "francecentral",
          "italynorth",
          "polandcentral",
          "spaincentral"
        ]
      }
    },
    "prodOnlyApproval": {
      "type": "object",
      "description": "Present only when production is the only environment: a person approved deploying it without a lower environment (who and when). Written by the Wizard from a checkbox; the agent never writes it.",
      "required": [
        "approvedBy",
        "approvedAt"
      ],
      "properties": {
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "environments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "level",
          "subscriptionId"
        ],
        "properties": {
          "name": {
            "enum": [
              "dev",
              "test",
              "prod"
            ]
          },
          "level": {
            "enum": [
              "basic",
              "standard",
              "premium"
            ]
          },
          "subscriptionId": {
            "type": "string",
            "maxLength": 400
          }
        },
        "additionalProperties": true
      }
    },
    "egress": {
      "type": "object",
      "required": [
        "firewall"
      ],
      "properties": {
        "firewall": {
          "enum": [
            "existing",
            "fortigate",
            "azure-firewall",
            "nat-gateway",
            "none"
          ]
        },
        "firewallNextHopIp": {
          "type": "string",
          "maxLength": 400
        },
        "azureFirewallApproval": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "required": [
        "gatewayMode",
        "existingGatewayId",
        "natGateway",
        "fixedOutboundIp",
        "existingRegistryId",
        "defenderPlans",
        "foundryPortalIps"
      ],
      "properties": {
        "gatewayMode": {
          "enum": [
            "new",
            "existing"
          ]
        },
        "existingGatewayId": {
          "type": "string",
          "maxLength": 400
        },
        "natGateway": {
          "type": "boolean"
        },
        "fixedOutboundIp": {
          "type": "boolean"
        },
        "existingRegistryId": {
          "type": "string",
          "maxLength": 400,
          "description": "The resource ID of an existing, shared container registry (Green and Yellow), often in a shared resource group. Empty: the landing zone has its own. Only from the Wizard or a person; never inferred."
        },
        "defenderPlans": {
          "type": "boolean"
        },
        "foundryPortalIps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 400
              },
              "address": {
                "type": "string",
                "maxLength": 400
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "apps": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "repository",
          "port",
          "hostName",
          "healthPath",
          "settings",
          "easyAuth",
          "database",
          "ai",
          "migrationJob"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 400
          },
          "kind": {
            "enum": [
              "web",
              "api",
              "worker"
            ]
          },
          "repository": {
            "type": "string",
            "maxLength": 400
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "hostName": {
            "type": "string",
            "maxLength": 400
          },
          "healthPath": {
            "type": "string",
            "maxLength": 400
          },
          "settings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "name",
                "secret"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 400
                },
                "secret": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "easyAuth": {
            "type": "boolean"
          },
          "database": {
            "type": "boolean"
          },
          "ai": {
            "type": "boolean"
          },
          "migrationJob": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "certificateSource": {
            "enum": [
              "customer-pfx",
              "key-vault-secret"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "foundry": {
      "type": "object",
      "required": [
        "enabled",
        "models"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "enum": [
            "basic",
            "premium"
          ]
        },
        "models": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "tokensPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "monthlyTokenQuota": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokensPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "totalMonthlyTokenQuota": {
          "type": "integer",
          "minimum": 0
        },
        "gateway": {
          "type": "object",
          "description": "Foundry Premium's AI gateway (2026-11-10). Absent: the landing zone creates its own API Management. existing needs the resource ID of a Microsoft.ApiManagement/service; principalId is a GUID; basic-v2 is refused unless Green has no network (aiGatewayRefusals). A new gateway's tier is standard-v2, or basic-v2 in Green without a network (aiGatewayTierFor).",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["new", "existing"] },
            "existingId": { "type": "string", "maxLength": 400 },
            "principalId": { "type": "string", "maxLength": 60 },
            "tier": { "enum": ["basic-v2", "standard-v2", "premium-v2"] }
          },
          "additionalProperties": false
        },
        "gatewayPrivateOnly": {
          "type": "array",
          "items": {
            "enum": [
              "dev",
              "test",
              "prod"
            ]
          },
          "maxItems": 3
        },
        "gatewayContact": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": true
    },
    "delivery": {
      "type": "object",
      "required": [
        "channel"
      ],
      "properties": {
        "channel": {
          "enum": [
            "github",
            "azure-devops",
            "bicep"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 400
        },
        "organization": {
          "type": "string",
          "maxLength": 400
        },
        "project": {
          "type": "string",
          "maxLength": 400
        },
        "repository": {
          "type": "string",
          "maxLength": 400
        },
        "reporting": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "properties": {
        "accessGroups": {
          "enum": [
            "ready",
            "pending",
            "unknown",
            ""
          ]
        },
        "eligibleAccounts": {
          "type": "string",
          "maxLength": 400
        },
        "accessAdmin": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 400
            },
            "email": {
              "type": "string",
              "maxLength": 400
            }
          },
          "additionalProperties": true
        },
        "socLogging": {
          "enum": [
            "ready",
            "pending",
            "unknown",
            ""
          ]
        },
        "customerActions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "ownershipMode": {
          "enum": [
            "platform-vended",
            "existing-compliant",
            "itm8-managed",
            "prototype-isolated"
          ]
        },
        "foundryOption": {
          "enum": [
            "not-used",
            "shared-itm8",
            "itm8-dedicated",
            "customer-foundry"
          ]
        }
      },
      "additionalProperties": true
    },
    "caf": {
      "type": "object",
      "properties": {
        "defenderInherited": {
          "type": "boolean"
        },
        "bastionPresent": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "dataPlatform": {},
    "landingZone": {
      "type": "object",
      "description": "Landing zone answers (2026-11-11), every field optional; absent keeps what the template does without it. addressSpace is the VNet range (default per zone). registry is Yellow's registry only: its network access (absent is private) or an existingId (a shared registry, possibly in another resource group or subscription). sharedResourceGroup is information only: where the shared App Gateway, Front Door, registry and API Management live; their IDs stay in edge, network and foundry.gateway. Copy from C1 or the Wizard; never infer.",
      "properties": {
        "addressSpace": { "type": "string", "maxLength": 20 },
        "registry": {
          "type": "object",
          "properties": {
            "access": { "enum": ["private", "public"] },
            "existingId": { "type": "string", "maxLength": 400 }
          },
          "additionalProperties": false
        },
        "postgresNetwork": { "type": "string", "enum": ["vnet-integration", "private-endpoint"], "description": "How PostgreSQL reaches the network. Unset means vnet-integration (stored answers). Fixed once the server exists." },
        "privateDns": {
          "type": "object",
          "description": "The customer's central private DNS zones. Unset means the landing zone creates its own zones.",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["central-policy", "central-zones"] },
            "zoneIds": {
              "type": "object",
              "propertyNames": { "type": "string", "enum": ["keyVault", "containerApps", "registry", "postgres", "cosmos", "cognitiveServices", "openAi", "aiServices", "apim", "blob"] },
              "additionalProperties": { "type": "string", "maxLength": 400 }
            },
            "dnsServers": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } }
          }
        },
        "sharedResourceGroup": {
          "type": "object",
          "required": ["subscriptionId", "name"],
          "properties": {
            "subscriptionId": { "type": "string", "maxLength": 60 },
            "name": { "type": "string", "maxLength": 90 }
          },
          "additionalProperties": false
        },
        "sreAgent": {
          "type": "object",
          "description": "The optional Azure SRE Agent (2026-11-18), Yellow and Red only. shared places it in sharedResourceGroup, solution in the platform resource group of the highest environment. Unset means no agent. Copy it from the Wizard; never infer.",
          "required": ["placement"],
          "additionalProperties": false,
          "properties": {
            "placement": { "type": "string", "enum": ["shared", "solution"] }
          }
        }
      },
      "additionalProperties": false
    },
    "platformKinds": {
      "type": "array",
      "description": "What the solution is (2026-11-11). Absent means azure-apps only. Without azure-apps (Fabric or Power Platform only) the solution may have no app: apps is empty and the agent writes a platform plan, not a rebuild.",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["azure-apps", "fabric", "power-platform"] }
    },
    "fabric": {
      "type": "object",
      "description": "The governed Fabric platform (2026-11-11); present only with the platform kind fabric. Written by the Wizard; the agent copies it and never invents it.",
      "properties": {
        "privateAccess": { "type": "boolean" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "content": {
                "type": "array",
                "description": "Content modules (2026-11-17) the customer's own role-holders create in this stage's workspace with the package's scripts, each after the data owner approved it. Absent means none. Copy it; never add, drop or reorder a module.",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": { "enum": ["lakehouse", "medallion", "semantic-model", "data-agent"] }
              }
            }
          }
        }
      }
    },
    "powerPlatform": {
      "description": "The governed Power Platform (2026-11-11); present only with the platform kind power-platform. Written by the Wizard; the agent copies it and never invents it."
    },
    "discovery": {},
    "services": {
      "type": "object",
      "properties": {
        "dnsOwnerRole": {
          "enum": [
            "customer-dns-mail",
            "customer-platform"
          ]
        },
        "mail": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "acs-email",
                "m365-connector"
              ]
            },
            "senderDomain": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "mode",
            "senderDomain"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dnsOwnerRole",
        "mail"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
