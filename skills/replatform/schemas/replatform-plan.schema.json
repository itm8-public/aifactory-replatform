{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itm8:aifactory:replatform-plan:1",
  "title": "AI Factory replatform plan",
  "description": "What the replatform agent produces. `assessment.report` and `assessment.draft` mirror the management app's analysisReportSchema and assessmentDraftSchema so they can be posted to POST /solutions/:solutionId/replatform-assessments unchanged. Everything else is plan-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "intake", "assessment", "risk", "hosting", "sharedResources", "appChanges", "allowedPaths", "secretsNeeded", "questions", "decisionLog"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": {
      "description": "draft: discovery running. questions: waiting for the owner. awaiting-approval: plan complete (kept for Management App compatibility). approved: the plan is ready to implement; the draft PR review is the human check. implementing: app changes in progress. ready-for-review: all checks passed, draft PR ready.",
      "enum": ["draft", "questions", "awaiting-approval", "approved", "implementing", "ready-for-review"]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "revision", "ownershipConfirmed"],
      "properties": {
        "kind": { "enum": ["git", "zip", "xml", "repomix"] },
        "source": { "type": "string", "maxLength": 500, "description": "Repository URL or upload file name. Never a token." },
        "revision": { "type": "string", "maxLength": 80, "description": "Commit ID of the intake-repository snapshot analysed. For a ZIP, this is the intake commit, not the archive digest." },
        "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the exact source package bytes represented by this field; never substitute it for a Git commit ID." },
        "ownershipConfirmed": { "type": "boolean" },
        "ownershipEvidence": { "type": "string", "maxLength": 300 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "draft"],
      "properties": {
        "report": { "$ref": "#/$defs/analysisReport" },
        "draft": { "$ref": "#/$defs/assessmentDraft" }
      }
    },
    "azureDiscovery": {
      "description": "Plan-only metadata for a Management App read-only Azure discovery. The immutable inventory remains in the Management App; this record carries scope and per-query evidence status only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "discoveryId", "contentSha256", "sourceScope", "discoveredAt", "correlationId", "queryEvidence"],
      "properties": {
        "status": { "enum": ["available", "partial", "unavailable"] },
        "reasonCode": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["engagement-not-integrated", "permission-not-granted", "connection-missing", "connection-revoked", "tenant-scope-missing", "tenant-scope-mismatch", "no-readable-subscriptions", "azure-reader-not-configured", "cooldown-active", "partial-results", "queries-unavailable"] }
          ]
        },
        "discoveryId": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uuid" }] },
        "contentSha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
        "sourceScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscriptionCount", "unavailableSubscriptionCount", "sha256"],
          "properties": {
            "subscriptionCount": { "type": "integer", "minimum": 0, "maximum": 50 },
            "unavailableSubscriptionCount": { "type": "integer", "minimum": 0, "maximum": 50 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
        "queryEvidence": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "status", "itemCount"],
            "properties": {
              "category": { "enum": ["subscriptions", "resourceGroups", "supportedRegions", "quotaUsage", "policyAssignments", "virtualNetworks", "gateways", "privateDnsZones", "workspaces", "sentinelWorkspaces", "keyVaults", "containerAppsEnvironments", "aiAccounts", "identities", "bastionHosts"] },
              "status": { "enum": ["available", "unavailable"] },
              "itemCount": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "integer", "minimum": 0, "maximum": 500 }
                ]
              }
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answers", "suggestedZone", "confirmedZone"],
      "properties": {
        "answers": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "answer", "source", "evidence"],
            "properties": {
              "id": { "enum": ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8", "a1", "a2", "a3"] },
              "answer": { "enum": ["yes", "no", "unknown"] },
              "source": { "enum": ["code", "owner"] },
              "evidence": { "$ref": "#/$defs/evidenceList" },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "suggestedZone": { "enum": ["green", "yellow", "red"] },
        "confirmedZone": { "description": "Always null when the agent writes it. A person sets it.", "type": "null" },
        "flags": { "type": "array", "items": { "enum": ["dpia", "ai-act-high-risk-check", "tool-approval", "eu-only", "transparency", "prohibited"] } }
      }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "platformGap", "signals", "decision"],
      "properties": {
        "recommended": { "enum": ["container-apps", "app-service", "static-web-apps", "functions", "copilot-app", "fabric-app", "other"] },
        "platformGap": { "type": "boolean", "description": "True when the recommended target has no AI Factory template." },
        "alternative": { "type": "string", "maxLength": 500 },
        "placementSuggestion": { "enum": ["A-shared", "A-dedicated", "B-caf", "B-public"] },
        "serviceLevels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dev": { "$ref": "#/$defs/level" },
            "test": { "$ref": "#/$defs/level" },
            "prod": { "$ref": "#/$defs/level" }
          }
        },
        "signals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "pointsTo", "evidence"],
            "properties": {
              "signal": { "type": "string", "maxLength": 200 },
              "pointsTo": { "enum": ["container-apps", "app-service", "static-web-apps", "functions", "other"] },
              "evidence": { "$ref": "#/$defs/evidenceList" }
            }
          }
        },
        "decision": {
          "description": "Null until the architect decides.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "by", "reason"],
              "properties": {
                "target": { "type": "string", "maxLength": 60 },
                "by": { "type": "string", "maxLength": 100 },
                "reason": { "type": "string", "maxLength": 1000 }
              }
            }
          ]
        }
      }
    },
    "sharedResources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "reuse", "reason"],
        "properties": {
          "need": { "enum": ["postgresql", "app-gateway", "front-door", "api-management", "registry", "key-vault", "container-apps-environment", "log-analytics", "foundry", "storage", "other"] },
          "reuse": { "type": "boolean" },
          "existing": { "type": "string", "maxLength": 300, "description": "Name or resource id of the shared resource reused, only as the Wizard or a person gave it; never inferred, also not from the shared resource group." },
          "reason": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "appChanges": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "reason", "evidence"],
        "properties": {
          "planItemId": { "type": "string", "pattern": "^APP-[0-9]{3}$", "description": "Stable plan-item id required before G2." },
          "path": { "type": "string", "maxLength": 500 },
          "change": { "enum": ["dockerfile", "health-endpoint", "configuration", "secrets-to-env", "managed-identity", "data-store", "migrations", "statelessness", "logging", "build-scripts", "wizard-spec", "other"] },
          "reason": { "type": "string", "maxLength": 500 },
          "evidence": { "$ref": "#/$defs/evidenceList" },
          "targetSpecField": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Exact field in assessment.draft.targetSpecDelta this change implements." }
        }
      }
    },
    "compatibilityBoundaries": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "description": "What must not change: public API shapes, URLs, data formats, behaviours people rely on." },
    "allowedPaths": {
      "description": "Files and folders the implementation may touch. Protected CI and code-owner paths are never allowed.",
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 500 }
    },
    "secretsNeeded": {
      "description": "Names only. A value here is a defect.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "usedBy"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$" },
          "usedBy": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "wizardSpecPath": { "type": "string", "maxLength": 300, "description": "Path of the draft ai-factory.json (wizard spec version 1) in the branch." },
    "costNote": { "type": "string", "maxLength": 1000 },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "why"],
        "properties": {
          "id": { "type": "string", "maxLength": 40 },
          "text": { "type": "string", "maxLength": 500 },
          "why": { "type": "string", "maxLength": 300 },
          "options": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 200 } },
          "answer": { "type": "string", "maxLength": 1000 },
          "answeredBy": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "decisionLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "by", "decision"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string", "maxLength": 100 },
          "decision": { "type": "string", "maxLength": 500 },
          "reason": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "decisionRecords": {
      "description": "Optional ADR-style records for material decisions. They make trade-offs reviewable without allowing the agent to approve itself.",
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/decisionRecord" }
    },
    "governanceGates": {
      "description": "Plan-only itm8 governance/security gates, applied zone-aware (GREEN: free automated checks only; YELLOW/RED: full set). Additive and not part of the posted assessment. See reference/governance-gates.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["appliedZone", "gates"],
      "properties": {
        "appliedZone": { "enum": ["green", "yellow", "red"], "description": "The suggested zone the gate set was applied for; confirmedZone remains the person's." },
        "gates": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "group", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^GATE-[A-Z0-9-]+$" },
              "group": { "enum": ["ownership", "production-readiness", "security-acceptance", "poc-to-production"] },
              "title": { "type": "string", "maxLength": 200 },
              "appliesAtZone": { "type": "boolean", "description": "Whether the gate is in force for appliedZone (false = out of scope at this zone, e.g. a human gate at GREEN)." },
              "blocking": { "type": "boolean", "description": "Whether an unmet gate keeps the pull request draft or blocks release review." },
              "status": { "enum": ["PASS", "FAIL", "WARN", "SKIPPED", "NOT RUN", "N/A"] },
              "ownerRole": { "type": "string", "maxLength": 120, "description": "Responsible role (for example 'system owner', 'business owner', 'security reviewer'); never a person's name." },
              "evidence": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "description": "Evidence ids or check pointers. Never personal names/emails; owner designation is a Management App reference." },
              "note": { "type": "string", "maxLength": 1000 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "level": { "enum": ["basic", "standard", "premium"] },
    "evidenceList": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "path": { "type": "string", "minLength": 1, "maxLength": 500 },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "basis", "detail", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["info", "low", "medium", "high"] },
        "basis": { "enum": ["fact", "unavailable", "inference"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidenceList" },
        "confidence": { "enum": ["low", "medium", "high"] }
      },
      "if": { "properties": { "basis": { "const": "inference" } } },
      "then": { "required": ["confidence"] },
      "else": { "not": { "required": ["confidence"] } }
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "context", "options", "recommendation", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["proposed", "approved", "rejected", "deferred", "superseded"] },
        "context": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "tradeOff"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 60 },
              "description": { "type": "string", "minLength": 1, "maxLength": 500 },
              "tradeOff": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optionId", "rationale", "evidence"],
          "properties": {
            "optionId": { "type": "string", "minLength": 1, "maxLength": 60 },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "evidence": { "$ref": "#/$defs/evidenceList" }
          }
        },
        "decision": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["optionId", "by", "at", "approvalRef"],
              "properties": {
                "optionId": { "type": "string", "minLength": 1, "maxLength": 60 },
                "by": { "type": "string", "minLength": 1, "maxLength": 100 },
                "at": { "type": "string", "format": "date-time" },
                "approvalRef": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },    "assessmentDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "currentArchitecture", "targetArchitecture", "findings", "targetSpecDelta", "backlog", "clarificationQuestions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "currentArchitecture": { "$ref": "#/$defs/architecture" },
        "targetArchitecture": { "$ref": "#/$defs/architecture" },
        "findings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/finding" } },
        "appProposal": { "$ref": "#/$defs/appProposal" },
        "targetSpecDelta": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "proposed", "rationale", "evidence"],
            "properties": {
              "field": { "type": "string", "minLength": 1, "maxLength": 120 },
              "proposed": { "type": "string", "minLength": 1, "maxLength": 500 },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "evidence": { "$ref": "#/$defs/evidenceList" }
            }
          }
        },
        "backlog": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "acceptanceCriteria", "evidence"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
              "evidence": { "$ref": "#/$defs/evidenceList" }
            }
          }
        },
        "clarificationQuestions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "appProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "source",
        "apps",
        "notes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "source": {
          "const": "replatform-agent"
        },
        "apps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/appProposalApp"
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What the analysis could not decide, in plain words."
        }
      },
      "description": "The apps the agent found, typed (contract C2). Mirrors the Management App's appProposalSchema with source replatform-agent; validate-plan checks the evidence."
    },
    "appProposalApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "root",
        "port",
        "healthPath",
        "settings",
        "database",
        "ai",
        "confidence",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,9}$",
          "description": "The Wizard's app name rule: lowercase letters, digits and hyphens, at most 10 characters."
        },
        "kind": {
          "enum": [
            "web",
            "api",
            "worker"
          ]
        },
        "root": {
          "type": "string",
          "maxLength": 500,
          "description": "The folder the app was found in, relative to the package root; empty for the root."
        },
        "port": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          ],
          "description": "Null when nothing in the code names one."
        },
        "healthPath": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200
            }
          ]
        },
        "settings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secret"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "secret": {
                "type": "boolean",
                "description": "True for the names that belong in Key Vault. Names only, never values."
              }
            }
          }
        },
        "database": {
          "type": "boolean"
        },
        "ai": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/appProposalEvidence"
          }
        }
      }
    },
    "appProposalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "path",
        "note"
      ],
      "properties": {
        "field": {
          "enum": [
            "app",
            "kind",
            "port",
            "healthPath",
            "settings",
            "database",
            "ai"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 500,
          "description": "A file in the assessed repository, relative to the package root. Never file content."
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "What was read there and why it decides the value."
        }
      }
    },
    "analysisReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packageSha256", "customerId", "solutionId", "revision", "facts", "toolErrors", "unavailable", "stats"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the exact source package bytes represented by this field; never substitute it for a repository commit ID." },
        "customerId": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uuid" }], "description": "Null until the management-app customer record is known." },
        "solutionId": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "uuid" }], "description": "Null until the management-app solution record is known." },
        "revision": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Commit ID of the analyzed intake-repository snapshot; distinct from packageSha256." },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components", "licenses", "iac", "tests", "runtimes", "secrets"],
          "properties": {
            "components": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ecosystem", "name", "version", "pinned", "scope", "declaredIn"],
                "properties": {
                  "ecosystem": { "enum": ["npm", "pypi", "nuget"] },
                  "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "version": { "type": "string", "maxLength": 100 },
                  "pinned": { "type": "boolean" },
                  "scope": { "enum": ["runtime", "dev"] },
                  "declaredIn": { "$ref": "#/$defs/path" }
                }
              }
            },
            "licenses": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "declaredIn", "license"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "declaredIn": { "$ref": "#/$defs/path" },
                  "license": { "type": "string", "minLength": 1, "maxLength": 100 }
                }
              }
            },
            "iac": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "kind"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "kind": { "enum": ["bicep", "terraform", "dockerfile", "kubernetes", "pipeline"] }
                }
              }
            },
            "tests": {
              "type": "array",
              "maxItems": 20000,
              "items": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/$defs/path" } } }
            },
            "runtimes": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "runtime", "version"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "runtime": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "version": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            },
            "secrets": {
              "type": "array",
              "maxItems": 20000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "rule", "count"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "rule": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "count": { "type": "integer" }
                }
              }
            }
          }
        },
        "toolErrors": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "path", "message"],
            "properties": {
              "check": { "const": "dependencies" },
              "path": { "$ref": "#/$defs/path" },
              "message": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "unavailable": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "reason"],
            "properties": {
              "check": { "type": "string", "minLength": 1, "maxLength": 60 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files"],
          "properties": { "files": { "type": "integer" } }
        }
      }
    }
  }
}
