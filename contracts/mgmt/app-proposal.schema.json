{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from packages/shared/src/schemas/appProposal.ts (appProposalSchema) by pnpm contracts:export. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "quick-scan",
        "replatform-agent",
        "wizard-agent"
      ]
    },
    "apps": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,9}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "api",
              "worker"
            ]
          },
          "root": {
            "type": "string",
            "maxLength": 500
          },
          "port": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "healthPath": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "settings": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "secret": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "secret"
              ],
              "additionalProperties": false
            }
          },
          "database": {
            "type": "boolean"
          },
          "ai": {
            "type": "boolean"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "app",
                    "kind",
                    "port",
                    "healthPath",
                    "settings",
                    "database",
                    "ai"
                  ]
                },
                "path": {
                  "type": "string",
                  "maxLength": 500
                },
                "note": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "field",
                "path",
                "note"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "kind",
          "root",
          "port",
          "healthPath",
          "settings",
          "database",
          "ai",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "apps",
    "notes"
  ],
  "additionalProperties": false
}
